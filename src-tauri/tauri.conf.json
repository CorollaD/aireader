{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiReader",
  "version": "0.4.0",
  "identifier": "com.aireader.reader",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AiReader",
        "width": 1200,
        "height": 820,
        "minWidth": 560,
        "minHeight": 420,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: book: http://book.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' book: http://book.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "epub"
        ],
        "name": "EPUB",
        "description": "EPUB e-book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/epub+zip",
        "contentTypes": [
          "org.idpf.epub-container"
        ]
      },
      {
        "ext": [
          "mobi",
          "azw",
          "azw3",
          "prc"
        ],
        "name": "Kindle book",
        "description": "MOBI / AZW3 e-book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-mobipocket-ebook"
      },
      {
        "ext": [
          "fb2"
        ],
        "name": "FictionBook",
        "description": "FB2 e-book",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/x-fictionbook+xml"
      },
      {
        "ext": [
          "cbz"
        ],
        "name": "Comic book",
        "description": "CBZ comic archive",
        "role": "Viewer",
        "rank": "Default",
        "mimeType": "application/vnd.comicbook+zip"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF",
        "description": "PDF document",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/pdf",
        "contentTypes": [
          "com.adobe.pdf"
        ]
      }
    ]
  }
}
