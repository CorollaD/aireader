{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AiReader",
        "width": 1200,
        "height": 820,
        "minWidth": 560,
        "minHeight": 420,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 22
        }
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "bash src-tauri/scripts/fetch-pdfium.sh --if-missing && npm run build"
  },
  "bundle": {
    "macOS": {
      "frameworks": [
        "lib/libpdfium.dylib"
      ]
    }
  }
}
